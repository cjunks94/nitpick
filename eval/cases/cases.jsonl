{"pr":121,"repo":"cjunks94/exportee-rails","diff_path":"eval/cases/pr-121.diff","expected":[{"file":"app/services/sources/salesforce_adapter.rb","line":45,"severity":"useful","category":"perf","keywords":["memory","OOM","stream","batch"],"note":"extract accumulates entire SOQL result in memory; a multi-million-row Account export would OOM the worker"},{"file":"app/services/sources/salesforce_adapter.rb","line":66,"severity":"critical","category":"correctness","keywords":["overrid","explicit nil","passing nil","api_version: nil","restforce default","default api"],"note":"explicit api_version: nil overrides Restforce's default in its options merge (concerns/base.rb merge!), so a connection that omits the documented-optional key hits /services/data/v/... and 404s on every call; specs stub Restforce.new so they can't see it"},{"file":"app/services/sources/salesforce_adapter.rb","line":27,"severity":"useful","category":"perf","keywords":["n+1","per object","per sobject","hundreds","api limit","sequential"],"note":"introspect_schema describes every queryable sobject in a sequential loop: hundreds of HTTP calls per introspection on a stock org, eating the daily API allocation; batch via composite describe or describe lazily"}]}
{"pr":101,"repo":"cjunks94/exportee-rails","diff_path":"eval/cases/pr-101.diff","expected":[{"file":"app/controllers/api/v1/base_controller.rb","line":83,"severity":"useful","category":"security","keywords":["leak","exception.message","internal"],"note":"bad_request_with_message renders raw exception.message from ArgumentError; risks leaking internal context (CLAUDE.md: error messages must not leak internal details)"},{"file":"app/controllers/api/v1/base_controller.rb","line":13,"severity":"useful","category":"correctness","keywords":["too broad","programmer error","arity","wrong number of arguments","hide","genuine bug","500"],"note":"rescuing ArgumentError globally converts programmer errors (wrong arity, Integer('x'), Pagy overflow) into client-facing 400s and hides real bugs from error tracking; rescue the specific enum-assignment case instead"}]}
