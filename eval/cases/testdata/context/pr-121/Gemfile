source "https://rubygems.org"

ruby "~> 3.3"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 7.2.3", ">= 7.2.3.1"
# The original asset pipeline for Rails [https://github.com/rails/sprockets-rails]
gem "sprockets-rails"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"
# Bundle and transpile JavaScript [https://github.com/rails/jsbundling-rails]
gem "jsbundling-rails"
# Hotwire's SPA-like page accelerator [https://turbo.hotwired.dev]
gem "turbo-rails"
# Hotwire's modest JavaScript framework [https://stimulus.hotwired.dev]
gem "stimulus-rails"
# Bundle and process CSS [https://github.com/rails/cssbundling-rails]
gem "cssbundling-rails"
# Build JSON APIs with ease [https://github.com/rails/jbuilder]
gem "jbuilder"
# Use Redis adapter to run Action Cable in production
# gem "redis", ">= 4.0.1"

# Use Kredis to get higher-level data types in Redis [https://github.com/rails/kredis]
# gem "kredis"

# Authentication & authorization
gem "devise"
gem "pundit"
gem "jwt"

# API documentation (OpenAPI from RSpec request specs)
gem "rswag-api"
gem "rswag-ui"

# Background jobs & scheduling
gem "sidekiq"
gem "sidekiq-cron"

# View decorators
gem "draper"

# Soft delete
gem "discard"

# Encryption at rest for sensitive config (DB credentials, etc.)
gem "lockbox"
gem "blind_index"

# Pagination
gem "pagy"

# Boundary validation (replaces Pydantic from source app)
gem "dry-validation"

# Cron expression parsing for schedule validation
gem "fugit"

# High-performance data processing (Rust-backed DataFrames)
# Disable with EXPORTEE_POLARS=0 to fall back to Ruby CSV stdlib
gem "polars-df"

# Salesforce REST API client
gem "restforce"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
# gem "image_processing", "~> 1.2"

# S3-compatible storage (Cloudflare R2, AWS S3, etc.) for Active Storage
gem "aws-sdk-s3", require: false

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false
  gem "rubocop-rspec", require: false
  gem "rubocop-performance", require: false

  # Test suite
  gem "rspec-rails", "~> 7.0"
  gem "rswag-specs"
  gem "factory_bot_rails"
  gem "faker"
  gem "shoulda-matchers"

  # Env vars
  gem "dotenv-rails"

  # Dependency vulnerability scanning
  gem "bundler-audit", require: false
end

group :development do
  # Use console on exceptions pages [https://github.com/rails/web-console]
  gem "web-console"
  gem "pry-rails"
end

group :test do
  gem "capybara"
  gem "cuprite"

  # Coverage measurement + Codecov upload format
  gem "simplecov", require: false
  gem "simplecov-cobertura", require: false

  # Better failure diffs
  gem "super_diff"

  # Terser one-liner specs (its(:foo) { is_expected.to eq ... })
  gem "rspec-its"

  # Pundit policy spec matchers (used starting Phase 4)
  gem "pundit-matchers"

  # ENV var stubbing for rake task specs
  gem "climate_control"
end
