# Drop this file as `.nitpick.yaml` at your repo root to override defaults.
# All fields are optional. nitpick uses sensible defaults when the file or
# any field is missing.

provider: anthropic                       # stub | deepseek | anthropic
model: claude-haiku-4-5                   # used when provider=anthropic

review:
  severity_threshold: useful              # nit | useful | critical — post anything >= this
  ignore_paths:
    - "vendor/**"
    - "**/*.lock"
    - "**/*.svg"
    - "**/testdata/**"
  categories_enabled:
    - correctness
    - security
    - perf

  # CodeRabbit interop. nitpick is designed to run ALONGSIDE CodeRabbit, not
  # instead of it: CodeRabbit covers style, naming, and generic refactors;
  # nitpick targets contract drift, unenforced security gates, and perf issues
  # tied to this repo's data shape.
  #
  # With this on, nitpick reads CodeRabbit's existing comments on the PR before
  # reviewing and tells the model what ground is already covered — so the two
  # bots stop restating each other. Without it, the prompt can only *guess* at
  # what CodeRabbit would have said.
  coderabbit:
    # Fetch CodeRabbit's comments and dedupe against them. Default: true.
    # Costs two extra GitHub requests per review (inline + top-level
    # comments), more on PRs with enough comments to paginate.
    enabled: true

    # Logins treated as CodeRabbit. Override for enterprise/self-hosted
    # installs. Default: ["coderabbitai[bot]", "coderabbitai"]
    # bots: ["coderabbitai[bot]"]

    # Wait for CodeRabbit to post before reviewing, so the dedup above always
    # has something to work with. Default: false.
    #
    # Turn this on only if CodeRabbit is reliably installed on this repo —
    # otherwise every review pays wait_timeout before giving up. nitpick NEVER
    # skips the review on timeout; it just proceeds with whatever it has.
    #
    # `serve` only. The `nitpick review` CLI ignores this: blocking a terminal
    # (or a billed Actions minute) on another bot is the wrong default.
    wait: false
    wait_timeout: 5m       # ceiling is 10m
    poll_interval: 15s     # floor is 5s

  # Free-form notes injected into the reviewer's system prompt as a cached
  # block. Tell the bot what's specific to THIS repo: language conventions,
  # framework-specific patterns, things the team doesn't want flagged.
  # Keep it short — bullets, not essays. Adding too much dilutes attention.
  #
  # When the bot has notes, it treats them as authoritative for this repo
  # and overrides its general defaults.
  context_notes: |
    Language conventions:
      - GDScript: `class_name X extends Y` declarations are repo-globally
        resolved. Do NOT flag missing imports or "undefined reference"
        findings for repo-local classes.
      - Test framework is GdUnit4 — use `before_test`/`after_test` hooks
        for cleanup. GDScript has no try/finally; don't suggest it.

    Repo-specific patterns:
      - SaveSystem.save_hub_world returns bool (true on success).
      - All run-state mutations go through `state_changed` signals.

    Things we don't want flagged here:
      - "Consider using a constant" for deliberately inline magic numbers.
      - "Add error handling" on signal handlers that intentionally swallow.
